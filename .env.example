X402_ENABLED=false
X402_ENVIRONMENT=development
X402_PRICE=$0.01

# Public EVM receiver address. Required when X402_ENABLED=true.
PAY_TO=

# CDP Facilitator / faucet authentication. No CDP wallet secret is required.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional for a local paid smoke test. If omitted, a disposable test wallet is generated.
EVM_PRIVATE_KEY=

# Explicit production safety gate
ALLOW_MAINNET=false

# Comma-separated EVM addresses are normalized at runtime
SANCTIONED_ADDRESSES=
